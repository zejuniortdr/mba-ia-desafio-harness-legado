{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "eslint.config.mjs", ".dependency-cruiser.cjs"],
      "project": ["scripts/*.mjs"]
    },
    "api": {
      "entry": ["src/main.ts", "src/jobs/triage-worker.ts", "prisma/seed.ts", "src/**/*.test.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "prisma/**/*.ts", "test/**/*.ts"]
    },
    "web": {
      "entry": ["src/main.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
