#!/usr/bin/env bash
# Gates antes de cada commit: tipos (G1, tsc), lint (G2, ESLint) e todas as outras regras.
# Ativado pelo `npm run up` (git config core.hooksPath .githooks).
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! npm run gates --silent; then
  echo
  echo "Commit bloqueado pelos gates: corrija as violações acima e tente de novo."
  exit 1
fi
